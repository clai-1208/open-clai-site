{
    "version": 1,
    "plugins": [
        {
            "id": "markdown",
            "name": "Markdown 节点",
            "version": "1.1.0",
            "description": "在画布中编辑与渲染 Markdown",
            "icon": "📝",
            "entry": "markdown.js"
        },
        {
            "id": "svg",
            "name": "SVG 节点",
            "version": "1.1.0",
            "description": "透明背景渲染 SVG,可接收上游文本节点的 SVG 源码",
            "icon": "🔷",
            "entry": "svg.js"
        },
        {
            "id": "html",
            "name": "HTML 节点",
            "version": "1.5.0",
            "description": "沙箱渲染 HTML，可按电脑/平板/手机画板预览并导出",
            "icon": "🌐",
            "entry": "html.js"
        },
        {
            "id": "panorama",
            "name": "3D 全景节点",
            "version": "1.1.0",
            "description": "查看 360° 等距柱状全景图,可从上游图片节点取图",
            "icon": "🧭",
            "entry": "panorama.js"
        },
        {
            "id": "sticky-note",
            "name": "便利贴节点",
            "version": "1.1.1",
            "description": "可自选颜色、双击编辑、拖动即可移动的便利贴",
            "icon": "📌",
            "entry": "sticky-note.js"
        },
        {
            "id": "director-desk",
            "name": "3D 导演台",
            "version": "1.0.1",
            "description": "嵌入小糟糕 3D 导演台,全屏编排镜头,截图落到画布图片节点",
            "icon": "🎬",
            "entry": "director-desk.js"
        },
        {
            "id": "documents",
            "name": "文档预览",
            "version": "1.1.0",
            "description": "在画布上查看、编辑 PDF、表格、Word 和幻灯片,不需要安装办公软件",
            "icon": "📄",
            "entry": "documents.js"
        },
        {
            "id": "browser",
            "name": "浏览器",
            "version": "1.1.5",
            "description": "弹出本机浏览器窗口，画布节点同步预览",
            "icon": "🌐",
            "entry": "browser.js"
        },
        {
            "id": "board",
            "name": "画板",
            "version": "1.1.1",
            "description": "手绘草稿、图层变换、混合模式与 PSD / 图片导出",
            "icon": "✎",
            "entry": "board.js"
        },
        {
            "id": "asset-extract",
            "name": "视觉资产提取",
            "version": "1.0.0",
            "description": "按章节提取人物、场景和道具，并接到生图节点",
            "icon": "🧩",
            "entry": "asset-extract.js"
        }
    ]
}
